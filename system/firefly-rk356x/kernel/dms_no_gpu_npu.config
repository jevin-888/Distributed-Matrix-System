# Dedicated RK3566 media appliance: keep DRM/V4L2/MPP/RGA/UART, remove GPU and NPU.
# CONFIG_MALI400 is not set
# CONFIG_MALI450 is not set
# CONFIG_MALI_SHARED_INTERRUPTS is not set
# CONFIG_MALI_DT is not set
# CONFIG_MALI_DEVFREQ is not set
# CONFIG_MALI_MIDGARD is not set
# CONFIG_MALI_EXPERT is not set
# CONFIG_MALI_PLATFORM_THIRDPARTY is not set
# CONFIG_MALI_DEBUG is not set
# CONFIG_MALI_PWRSOFT_765 is not set
# CONFIG_MALI_BIFROST is not set
# CONFIG_MALI_BIFROST_EXPERT is not set
# CONFIG_MALI_BIFROST_DEBUG is not set
# CONFIG_DRM_PANFROST is not set
# CONFIG_ROCKCHIP_RKNPU is not set

# Wired-only appliance: omit Bluetooth, Wi-Fi and RF-kill stacks.
# CONFIG_BT is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_RFKILL is not set

# PCIe disabled: no PCIe peripherals, and pcie-dw-rockchip depends on rfkill-wlan
# CONFIG_PCIE_DW_ROCKCHIP is not set

# USB gadget: RNDIS/FunctionFS plus keyboard and mouse HID for KVM.
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_HID=y
