# BR2_PACKAGE_VULKAN_LOADER is not set
# BR2_PACKAGE_VULKAN_TOOLS is not set
# BR2_PACKAGE_LIBMALI is not set
# BR2_PACKAGE_RKNPU2 is not set
# BR2_PACKAGE_RKNN_DEMO is not set
