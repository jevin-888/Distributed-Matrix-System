#include "base/base.config"
#include "chips/rk3566_rk3568_aarch64.config"

# Dedicated appliance identity and glibc/C++ runtime
BR2_TARGET_GENERIC_HOSTNAME="distributed-matrix"
BR2_TARGET_GENERIC_ISSUE="Distributed Matrix RK3566 Appliance"
BR2_TARGET_GENERIC_ROOT_PASSWD="linaro"
BR2_ROOTFS_OVERLAY="board/rockchip/dms-overlay"
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_ENABLE_LOCALE=y
BR2_GENERATE_LOCALE="C en_US.UTF-8 zh_CN.UTF-8"

# Keep only the flashable ext4 root filesystem
# BR2_TARGET_ROOTFS_CPIO is not set
# BR2_TARGET_ROOTFS_CPIO_GZIP is not set
# BR2_TARGET_ROOTFS_SQUASHFS is not set
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# The RK3566 Linux 5.10 target repeatedly rejects the freshly flashed JBD2
# superblock. Use ext4 without a journal so rootfs mounting does not depend on
# JBD2; extents, directory indexes and metadata checksums remain enabled.
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit,^has_journal"

# Production maintenance uses Ethernet/Dropbear and serial console; omit Android ADB.
# BR2_PACKAGE_RKSCRIPT is not set
# BR2_PACKAGE_RKTOOLKIT is not set
# BR2_PACKAGE_ANDROID_ADBD is not set

# Network and remote maintenance
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
# Dropbear must not block every first SSH connection on an unseeded CRNG.
# Its non-blocking /dev/urandom fallback is suitable for this appliance and
# the persistent random seed is still loaded by S20urandom.
BR2_PACKAGE_DROPBEAR_LOCALOPTIONS_FILE="package/dropbear/dms-localoptions.h"
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBOPENSSL=y
BR2_PACKAGE_LIBCURL=y
# BR2_PACKAGE_LIBCURL_CURL is not set
BR2_PACKAGE_LIBCURL_OPENSSL=y
# BR2_PACKAGE_LIBCURL_TLS_NONE is not set
# Application only downloads HTTP/HTTPS media; omit unused proxy, cookie and
# non-HTTP protocol stacks from libcurl while retaining TLS and CA validation.
# BR2_PACKAGE_LIBCURL_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_EXTRA_PROTOCOLS_FEATURES is not set
# BR2_PACKAGE_LIBOPENSSL_UNSECURE is not set
# BR2_PACKAGE_I2C_TOOLS is not set

# ALSA audio
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ROCKCHIP_ALSA_CONFIG=y

# V4L2 / media graph / HDMI-MIPI capture diagnostics
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_LIBV4L_UTILS=y

# DRM/KMS, Rockchip MPP and RGA; no display server and no GPU userspace
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_ROCKCHIP_MPP=y
BR2_PACKAGE_ROCKCHIP_MPP_ALLOCATOR_DRM=y
BR2_PACKAGE_ROCKCHIP_RGA=y
BR2_PACKAGE_GSTREAMER1_ROCKCHIP=y

# Minimal GStreamer runtime required one-to-one by MediaPlayer factories
BR2_PACKAGE_GSTREAMER1=y
BR2_PACKAGE_GSTREAMER1_GST_DEBUG=y
BR2_PACKAGE_GST1_PLUGINS_BASE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_PLAYBACK=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_APP=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERTSCALE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_PANGO=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_ALSA=y
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_JPEG=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PNG=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_IMAGEFREEZE=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_VIDEOCROP=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_RTP=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_RTPMANAGER=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_UDP=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUDIOPARSERS=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_MATROSKA=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_MPG123=y
BR2_PACKAGE_GST1_PLUGINS_BAD=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_DEBUGUTILS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_KMS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_FAAD=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_SANS=y
# BR2_PACKAGE_DEJAVU_MONO is not set
# BR2_PACKAGE_DEJAVU_SANS_CONDENSED is not set
# BR2_PACKAGE_DEJAVU_SERIF is not set
# BR2_PACKAGE_DEJAVU_SERIF_CONDENSED is not set

# RS232 / RS485 userspace validation; kernel UART/RS485 support is built-in
BR2_PACKAGE_PICOCOM=y
BR2_PACKAGE_SETSERIAL=y
BR2_PACKAGE_LIBSERIALPORT=y

BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="board/rockchip/common/base/busybox.fragment package/busybox/busybox_dms_trim.config"

# Production image: omit development/debug diagnostics.
# BR2_PACKAGE_GDB is not set
# BR2_PACKAGE_GDB_SERVER is not set
# BR2_PACKAGE_STRACE is not set
# BR2_PACKAGE_LSOF is not set
# BR2_PACKAGE_PROCPS_NG is not set
# BR2_PACKAGE_HTOP is not set
# BR2_PACKAGE_FILE is not set

# Application and boot-time service
BR2_PACKAGE_DISTRIBUTED_MATRIX=y

# Explicitly exclude desktop, GPU, Vulkan and NPU stacks
# BR2_PACKAGE_XORG7 is not set
# BR2_PACKAGE_WAYLAND is not set
# BR2_PACKAGE_WESTON is not set
